<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Reggex.Desktop.ViewModels"
        xmlns:avaloniaEdit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1050" d:DesignHeight="760"
        x:Class="Reggex.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/favicon.ico"
        Title="Reggex — Regular Expression Tester"
        RequestedThemeVariant="Dark"
        Width="1240" Height="860" MinWidth="760" MinHeight="680"
        Background="#10141B">

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="24" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="Reggex" FontSize="25" FontWeight="Bold" />
                <TextBlock Text="Regular Expression Tester" Foreground="#9BA7B8" FontSize="13" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <RadioButton Content="Find" GroupName="ApplicationMode" Classes="mode-selector"
                             IsChecked="{Binding IsFindMode, Mode=TwoWay}" />
                <RadioButton Content="Replace" GroupName="ApplicationMode" Classes="mode-selector"
                             IsChecked="{Binding IsReplaceMode, Mode=TwoWay}" />
                <RadioButton Content="Split" GroupName="ApplicationMode" Classes="mode-selector"
                             IsChecked="{Binding IsSplitMode, Mode=TwoWay}" />
                <Button Content="Generate C#…" Click="OnGenerateCodeClick" Margin="12,0,0,0" Padding="12,7" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#171D27" BorderBrush="#293343" BorderThickness="1"
                CornerRadius="12" Padding="16">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Text="REGEX" FontSize="11" FontWeight="Bold" Foreground="#9BA7B8"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text=".NET · multiline" FontSize="11" Foreground="#77869A" />
                </Grid>
                <TextBox x:Name="PatternEditor" Grid.Row="1"
                         Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                         FontFamily="Consolas" FontSize="14" Padding="12" MinHeight="84" MaxHeight="130"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         PlaceholderText="Enter a regular expression…" />
                <Border Grid.Row="2" IsVisible="{Binding HasError}" Background="#3A2027"
                        BorderBrush="#8B3948" BorderThickness="1" CornerRadius="7" Padding="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FFB8C1" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ErrorPosition}" Foreground="#D9949F" FontSize="11"
                                   IsVisible="{Binding HasErrorPosition}" />
                    </StackPanel>
                </Border>
                <TextBlock Grid.Row="3" Text="Changes are evaluated automatically · 500 ms timeout"
                           FontSize="11" Foreground="#77869A" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#171D27" BorderBrush="#293343" BorderThickness="1"
                CornerRadius="10" Padding="12,8">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="OPTIONS" FontSize="10" FontWeight="Bold" Foreground="#8391A5"
                           VerticalAlignment="Center" Margin="4,0,12,0" />
                <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" Margin="4,2" />
                <CheckBox Content="Multiline" IsChecked="{Binding Multiline}" Margin="4,2" />
                <CheckBox Content="Singleline" IsChecked="{Binding Singleline}" Margin="4,2" />
                <CheckBox Content="Explicit capture" IsChecked="{Binding ExplicitCapture}" Margin="4,2" />
                <CheckBox Content="Ignore pattern whitespace" IsChecked="{Binding IgnorePatternWhitespace}" Margin="4,2" />
                <CheckBox Content="Culture invariant" IsChecked="{Binding CultureInvariant}" Margin="4,2" />
                <CheckBox Content="Right to left" IsChecked="{Binding RightToLeft}" Margin="4,2" />
                <CheckBox Content="Non-backtracking" IsChecked="{Binding NonBacktracking}" Margin="4,2" />
            </WrapPanel>
        </Border>

        <Grid x:Name="ResultsLayout" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#171D27" BorderBrush="#293343" BorderThickness="1"
                    CornerRadius="12" Padding="16">
                <Grid RowDefinitions="Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="SOURCE" FontSize="11" FontWeight="Bold" Foreground="#9BA7B8" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SourceFileStatus}" FontSize="11" Foreground="#77869A"
                                       VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" />
                            <CheckBox Content="Word wrap" IsChecked="{Binding SourceWordWrap}" VerticalAlignment="Center" />
                            <Button Content="Load file…" Click="OnLoadSourceFileClick" Padding="8,4"
                                    Background="#202735" Foreground="#C5D2E3" BorderBrush="#303B4C" />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#111720" BorderBrush="#303B4C" BorderThickness="1"
                            CornerRadius="5">
                        <avaloniaEdit:TextEditor x:Name="SourceEditor"
                                                 TextChanged="OnSourceTextChanged"
                                                 FontFamily="Consolas" FontSize="14"
                                                 ShowLineNumbers="False" WordWrap="{Binding SourceWordWrap}"
                                                 Background="#111720" Foreground="#E5EAF1" />
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch" Cursor="SizeWestEast" />

            <Grid Grid.Column="2">
                <Border IsVisible="{Binding IsFindMode}" Background="#171D27" BorderBrush="#293343"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="MATCHES" FontSize="11" FontWeight="Bold" Foreground="#9BA7B8" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Max" Foreground="#93A1B5" VerticalAlignment="Center" />
                                <NumericUpDown Value="{Binding MaximumResults}"
                                               Minimum="1" Maximum="1000000" Increment="100"
                                               FormatString="0" Width="120" VerticalAlignment="Center" />
                                <TextBlock Text="Evaluating…" Foreground="#93A6BE"
                                           IsVisible="{Binding IsEvaluating}" />
                                <TextBlock Text="{Binding MatchCountText}" Foreground="#A9C8FF" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock Text="No matches found" Foreground="#77869A" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" IsVisible="{Binding HasNoMatches}" />
                            <ListBox ItemsSource="{Binding Matches}" IsVisible="{Binding HasMatches}"
                                     Classes="virtualized-list"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#202735" CornerRadius="8" Padding="10" Margin="0,0,0,8"
                                                Cursor="Hand" PointerPressed="OnMatchPointerPressed">
                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                                                <TextBlock Text="{Binding Value}" FontFamily="Consolas"
                                                           Foreground="#E5EAF1" TextWrapping="Wrap" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Index, StringFormat='Index {0}'}"
                                                               Foreground="#93A1B5" FontSize="11" />
                                                    <TextBlock Text="{Binding Length, StringFormat='Length {0}'}"
                                                               Foreground="#93A1B5" FontSize="11" />
                                                </StackPanel>
                                                <ItemsControl Grid.Row="1" Grid.ColumnSpan="2"
                                                              ItemsSource="{Binding Groups}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="#293548" CornerRadius="5"
                                                                    Padding="6,3" Margin="0,0,6,4">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <TextBlock Text="{Binding Name}"
                                                                               Foreground="#A9C8FF" FontSize="10" />
                                                                    <TextBlock Text="=" Foreground="#77869A"
                                                                               FontSize="10" />
                                                                    <TextBlock Text="{Binding Value}"
                                                                               Foreground="#E5EAF1"
                                                                               FontFamily="Consolas" FontSize="10" />
                                                                </StackPanel>
                                                                <ToolTip.Tip>
                                                                    <Border Background="#171D27" BorderBrush="#39475B"
                                                                            BorderThickness="1" CornerRadius="6"
                                                                            Padding="10">
                                                                        <StackPanel MaxWidth="420" Spacing="6">
                                                                            <TextBlock Text="{Binding Name, StringFormat='Group {0}'}"
                                                                                       Foreground="#A9C8FF"
                                                                                       FontWeight="Bold" />
                                                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                                                <TextBlock Text="{Binding Index, StringFormat='Index {0}'}"
                                                                                           Foreground="#C2CBD8" />
                                                                                <TextBlock Text="{Binding Length, StringFormat='Length {0}'}"
                                                                                           Foreground="#C2CBD8" />
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding Captures.Length, StringFormat='Captures ({0})'}"
                                                                                       Foreground="#9BA7B8" />
                                                                            <ItemsControl ItemsSource="{Binding Captures}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Grid ColumnDefinitions="Auto,Auto,*"
                                                                                              ColumnSpacing="10">
                                                                                            <TextBlock Text="{Binding Index, StringFormat='Index {0}'}"
                                                                                                       Foreground="#93A1B5"
                                                                                                       FontSize="11" />
                                                                                            <TextBlock Grid.Column="1"
                                                                                                       Text="{Binding Length, StringFormat='Length {0}'}"
                                                                                                       Foreground="#93A1B5"
                                                                                                       FontSize="11" />
                                                                                            <TextBlock Grid.Column="2"
                                                                                                       Text="{Binding Value}"
                                                                                                       Foreground="#E5EAF1"
                                                                                                       FontFamily="Consolas"
                                                                                                       TextWrapping="Wrap" />
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </ToolTip.Tip>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>

                <Grid IsVisible="{Binding IsReplaceMode}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#171D27" BorderBrush="#293343" BorderThickness="1"
                            CornerRadius="12" Padding="16">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="REPLACEMENT" FontSize="11" FontWeight="Bold"
                                           Foreground="#9BA7B8" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text=".NET replacement syntax" FontSize="11"
                                           Foreground="#77869A" TextWrapping="Wrap" />
                            </WrapPanel>
                            <TextBox x:Name="ReplacementEditor" Grid.Row="1"
                                     Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                     FontFamily="Consolas" FontSize="14" Padding="12" MinHeight="60"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="Replacement text…" />
                        </Grid>
                    </Border>
                    <GridSplitter Grid.Row="1" ResizeDirection="Rows" ResizeBehavior="PreviousAndNext"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                  Cursor="SizeNorthSouth" />
                    <Border Grid.Row="2" Background="#171D27" BorderBrush="#293343" BorderThickness="1"
                            CornerRadius="12" Padding="16">
                        <Grid RowDefinitions="Auto,*" RowSpacing="10">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <TextBlock Text="OUTPUT" FontSize="11" FontWeight="Bold" Foreground="#9BA7B8" />
                                <TextBlock Grid.Column="1" Text="{Binding MatchCountText}" Foreground="#A9C8FF"
                                           TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBox Grid.Row="1" Text="{Binding ReplacementOutput}" IsReadOnly="True"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                     FontFamily="Consolas" FontSize="13" Padding="12" MinHeight="60"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="The replaced text will appear here…" />
                        </Grid>
                    </Border>
                </Grid>

                <Border IsVisible="{Binding IsSplitMode}" Background="#171D27" BorderBrush="#293343"
                        BorderThickness="1" CornerRadius="12" Padding="16">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="SPLIT SEGMENTS" FontSize="11" FontWeight="Bold"
                                       Foreground="#9BA7B8" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Evaluating…" Foreground="#93A6BE"
                                           IsVisible="{Binding IsEvaluating}" />
                                <TextBlock Text="{Binding SplitSegmentCountText}" Foreground="#A9C8FF" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                            <TextBlock Text="No segments" Foreground="#77869A" VerticalAlignment="Center"
                                       HorizontalAlignment="Center" IsVisible="{Binding HasNoSplitSegments}" />
                            <ListBox ItemsSource="{Binding SplitSegments}" IsVisible="{Binding HasSplitSegments}"
                                     Classes="virtualized-list"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#202735" CornerRadius="8" Padding="10"
                                                Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding IndexLabel}" FontFamily="Consolas" />
                                                <TextBlock Text="{Binding Value}" FontFamily="Consolas"
                                                           TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>

    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#111720" />
            <Setter Property="BorderBrush" Value="#303B4C" />
            <Setter Property="Foreground" Value="#E5EAF1" />
            <Setter Property="CaretBrush" Value="#8AB4FF" />
        </Style>
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#C2CBD8" />
        </Style>
        <Style Selector="RadioButton.mode-selector">
            <Setter Property="Padding" Value="12,7" />
        </Style>
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="#293343" />
        </Style>
        <Style Selector="ListBox.virtualized-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.virtualized-list ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.virtualized-list ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.virtualized-list ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.virtualized-list ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Window.Styles>

</Window>
